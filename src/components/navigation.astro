---
const matches = import.meta.glob('../pages/*.astro', { eager: true });
const posts = Object.values(matches);
---

<ul>
{posts.map
(post => 
<li><a href={post.url ? post.url : '/'}>
    ♥ {post.file.slice(
    post.file.lastIndexOf('/') + 1,
    post.file.indexOf('.')
    )}
        </a></li>
        )}</ul>
