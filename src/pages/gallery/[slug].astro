---
import '../../styles/image-gallery.sass'

import Layout from '../../components/layout.astro'
import { getCollection } from "astro:content";
import { getAlbumImages } from "../../utils/albums";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const albums = await getCollection("albums");

  console.log("All albums:", albums.map(a => ({ slug: a.slug, id: a.id })));

  const paths = Object.values(albums).map((album) => {
    return {
      params: {
        slug: album.slug,
      },
      props: {
        album,
      },
    };
  });

  console.log("Generated paths:", paths.map(p => p.params));

  return paths;
}
const { album } = Astro.props;
const images = await getAlbumImages(album.slug);
---
<Layout>
  <h1 slot='title'>{album.slug}</h1>
  <h3 slot='banner'>these photos are not clickable >:p </h3>

<ul slot='content' class="photogallery">
    {
    images.map((image) => (
    <li>
            <Image 
            src={image}
            alt=""
            quality="max"
            loading="lazy"
            />
    </li>
    ))
    }
</ul>
