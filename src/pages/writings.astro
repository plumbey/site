---
import Layout from '../components/layout.astro'
const matches = import.meta.glob('./writings/*.mdx', { eager: true });
const posts = Object.values(matches);
---

<Layout title="Emma's Writings!">
    <h1 slot='title'>writings</h1>
        <ul slot='content'>
        {posts.map
        (post => 
        <li><a href={post.url}>
               {post.title}
            </a></li>
        )}
        </ul>
</Layout>
